{
  "name": "dsh-chinese-cot",
  "version": "1.0.0",
  "description": "Puts one editable line at the very front of every DeepSeek Harness system prompt, so the model thinks in Chinese. Ships a switch and a settings page.",
  "type": "module",
  "license": "MIT",
  "author": "tiny-andr",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiny-andr/dsh-chinese-cot.git"
  },
  "homepage": "https://github.com/tiny-andr/dsh-chinese-cot",
  "bugs": {
    "url": "https://github.com/tiny-andr/dsh-chinese-cot/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "system-prompt",
    "chain-of-thought",
    "chinese"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
